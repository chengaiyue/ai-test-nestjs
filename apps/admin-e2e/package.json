{
  "name": "admin-e2e",
  "version": "0.0.1",
  "private": true,
  "devDependencies": {
    "axios": "^1.6.0"
  },
  "nx": {
    "implicitDependencies": [
      "admin"
    ],
    "targets": {
      "e2e": {
        "executor": "nx:run-commands",
        "outputs": [
          "{projectRoot}/test-output/jest/coverage"
        ],
        "dependsOn": [
          "admin:build",
          "admin:serve"
        ],
        "options": {
          "command": "jest --selectProjects admin-e2e --passWithNoTests"
        }
      }
    }
  }
}
