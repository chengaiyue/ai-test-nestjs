{
  "name": "api-e2e",
  "version": "0.0.1",
  "private": true,
  "devDependencies": {
    "axios": "^1.6.0"
  },
  "nx": {
    "implicitDependencies": ["api"],
    "targets": {
      "e2e": {
        "executor": "nx:run-commands",
        "outputs": ["{projectRoot}/test-output/jest/coverage"],
        "dependsOn": ["api:build", "api:serve"],
        "options": {
          "command": "jest --selectProjects api-e2e --passWithNoTests"
        }
      }
    }
  }
}
