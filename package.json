{
  "name": "ai-test-nestjs",
  "version": "0.0.1",
  "description": "NestJS Nx monorepo (apps + libs), managed with pnpm",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "nx run-many -t build",
    "test": "jest --selectProjects api admin @app/common",
    "test:e2e": "nx run-many -t e2e",
    "lint": "nx run-many -t lint",
    "serve:api": "nx serve api",
    "serve:admin": "nx serve admin",
    "format": "prettier --write \"**/*.ts\"",
    "graph": "nx graph",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "axios": "^1.6.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^12.0.1",
    "@nx/eslint": "23.1.3",
    "@nx/eslint-plugin": "23.1.3",
    "@nx/jest": "23.1.3",
    "@nx/js": "23.1.3",
    "@nx/nest": "23.1.3",
    "@nx/node": "23.1.3",
    "@nx/web": "23.1.3",
    "@nx/webpack": "23.1.3",
    "@swc/core": "~1.15.5",
    "@swc/helpers": "~0.5.18",
    "@swc/jest": "~0.2.38",
    "@types/jest": "~30.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "jest": "~30.3.0",
    "jest-environment-node": "~30.3.0",
    "jest-util": "~30.3.0",
    "jsonc-eslint-parser": "^2.1.0",
    "nx": "23.1.3",
    "prettier": "^3.4.2",
    "ts-jest": "^29.4.7",
    "ts-node": "10.9.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.58.0",
    "webpack": "^5.101.3",
    "webpack-cli": "^7.0.0",
    "webpack-dev-server": "^5.2.1"
  }
}
